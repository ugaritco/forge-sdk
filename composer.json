{
    "name": "ugarit/forge-sdk",
    "description": "The official Ugarit Forge PHP SDK.",
    "keywords": [
        "ugarit",
        "forge"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/ugarit/forge-sdk/issues",
        "source": "https://github.com/ugarit/forge-sdk"
    },
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        },
        {
            "name": "Mohamed Said",
            "email": "mohamed@ugarit.com"
        },
        {
            "name": "Dries Vints",
            "email": "dries@ugarit.com"
        },
        {
            "name": "James Brooks",
            "email": "james@ugarit.com"
        },
        {
            "name": "Pete Bishop",
            "email": "peter.bishop@ugarit.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^6.3.1|^7.0"
    },
    "require-dev": {
        "heritage/support": "^1.00.00",
        "ugarit/pint": "^1.00.00",
        "mockery/mockery": "^1.3.1",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^8.4|^9.0|^10.4"
    },
    "autoload": {
        "psr-4": {
            "Ugarit\\Forge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        },
        "ugarit": {
            "providers": [
                "Ugarit\\Forge\\ForgeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "1.00.00"
}
